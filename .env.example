# ==============================================================================
# Career Agent - Environment Configuration
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ==============================================================================

# Application Port (default: 8000)
PORT=12000

# Docker Image Tag (optional, defaults to latest)
# CAREER_AGENT_IMAGE=ghcr.io/regisx001/career-agent:latest

# ==============================================================================
# LLM Provider Configuration
# Compatible with OpenAI, DeepSeek, Ollama, OpenRouter, Groq, etc.
# ==============================================================================

# # OpenAI / Compatible API Key
# OPENAI_API_KEY=your-api-key-here

# # Model Identifier
# # Examples:
# #   - DeepSeek: deepseek-chat
# #   - OpenAI:   gpt-4o-mini, gpt-4o
# #   - Groq:     llama-3.3-70b-versatile
# OPENAI_MODEL_NAME=deepseek-chat

# # API Base URL (leave default for DeepSeek, change for OpenAI or custom proxy)
# # Examples:
# #   - DeepSeek: https://api.deepseek.com
# #   - OpenAI:   https://api.openai.com/v1
# #   - Local:    http://host.docker.internal:11434/v1
# OPENAI_BASE_URL=https://api.deepseek.com
